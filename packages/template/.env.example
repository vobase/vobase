PORT=3000
TZ=Asia/Singapore

DATABASE_URL=postgres://vobase:vobase@localhost:5432/vobase
# On Neon, set this to the direct (non-pooler) endpoint — pooled sessions drop LISTEN/NOTIFY.
# DATABASE_URL_DIRECT=postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require

# VITE_PRODUCT_NAME=Vobase
# VITE_VENDOR_NAME=Vobase

# ≥32 chars. Also the KEK seed for envelope-encrypted access tokens.
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-secret
BETTER_AUTH_URL=http://localhost:5173
# VITE_ALLOWED_EMAIL_DOMAINS=vobase.dev
# VOBASE_MULTI_ORG=true

# Bifrost routes all LLM traffic when both are set; otherwise direct provider keys below are used.
# BIFROST_API_KEY=sk-bf-...
# BIFROST_URL=http://localhost:8080
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# Local dev: MailDev on :1025, UI at http://localhost:1080.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@vobase.local
# SMTP_USER=
# SMTP_PASS=

# Required in production; dev falls back to 'dev-secret'.
CHANNEL_WEB_WEBHOOK_SECRET=
# WIDGET_ALLOWED_ORIGINS=https://customer-site.example.com

# WhatsApp Embedded Signup with your own Meta app (cloud-API + coexistence flows).
# Skip this block if you connect to a Vobase platform (block at the bottom) — the
# platform owns the Meta app and proxies signup. For a single hardcoded number,
# set META_WA_* fallbacks instead (see modules/channels/adapters/whatsapp/factory.ts).
# META_APP_ID=
# META_APP_SECRET=
# META_APP_CONFIG_ID_CLOUD=
# META_APP_CONFIG_ID_COEXISTENCE=
# META_APP_API_VERSION=v22.0

# All four R2_* required to enable R2/S3; otherwise filesystem at STORAGE_BASE_PATH.
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_REGION=auto
# STORAGE_BASE_PATH=./.data/storage

# Connect to a Vobase platform for OAuth, managed WhatsApp sandbox, and webhook self-registration.
# VITE_PLATFORM_URL=http://localhost:3001
# VITE_PLATFORM_TENANT_SLUG=local
# PLATFORM_HMAC_SECRET=dev-local-hmac-secret-do-not-use-in-production
# Cascade: WEBHOOK_BASE_URL → PUBLIC_BASE_URL → BETTER_AUTH_URL → http://localhost:$PORT. Local dev: point at backend port (3000), not Vite (5173).
# WEBHOOK_BASE_URL=http://localhost:3000
# PUBLIC_BASE_URL=https://your-tunnel.example.com

# 0 = no proxy. 1 = Cloud Run / Vercel. 2 = Cloudflare → Cloud Run.
TRUST_PROXY_HOPS=0
